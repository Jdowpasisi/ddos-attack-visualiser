# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ddos_attack_map

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Ingestion Settings
INGESTION_INTERVAL_SECONDS=10
INGESTION_BATCH_SIZE=5

# Geo Service Backend (mock or ip-api)
GEO_BACKEND=mock

# AbuseIPDB API Key (get free key at https://www.abuseipdb.com/api)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Cloudflare API Token (for Radar attack data - https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
